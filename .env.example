# Copy to .env if you need to customize. No npm dependencies are required.
# HTTP mode is for your trusted LAN; it is not encrypted.
LAN_RELAY_HOST=0.0.0.0
LAN_RELAY_PORT=4318
# Default data directory is .lan-relay-data inside this repository.
# LAN_RELAY_DATA_DIR=C:\Users\YOUR_NAME\LANRelayData
# Defaults: 2 GiB per file, 20 GiB managed storage, 2 MiB chunks.
# LAN_RELAY_MAX_FILE_BYTES=2147483648
# LAN_RELAY_MAX_STORAGE_BYTES=21474836480
# LAN_RELAY_CHUNK_SIZE=2097152
# Optional trusted TLS certificate files. Specify both; never commit private keys.
# LAN_RELAY_TLS_KEY=C:\certs\lan-relay-key.pem
# LAN_RELAY_TLS_CERT=C:\certs\lan-relay-cert.pem
# Optional directly executable Android SDK analyzer; built-in APK reading needs no SDK.
# .bat/.cmd shell launchers are not executed by V1. This optional field may be omitted.
# LAN_RELAY_APKANALYZER=/opt/android-sdk/cmdline-tools/latest/bin/apkanalyzer
# Only for an explicitly trusted reverse-proxy/QA origin; no wildcards.
# LAN_RELAY_ALLOWED_ORIGINS=https://your-specific-preview.example
