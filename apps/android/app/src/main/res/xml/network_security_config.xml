<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Dynamic private-IP LAN hosts cannot be enumerated here. LinkPolicy limits
         every WebView request and authenticated download to the user-approved origin. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
